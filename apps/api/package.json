{
  "name": "@erp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "nest build && vitest run",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "nest build && node dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "argon2": "0.45.1",
    "jose": "6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "prisma": "~7.10.0"
  }
}
