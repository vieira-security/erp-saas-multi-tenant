// Diretrizes (ver docs/database.md):
// - PostgreSQL compartilhado; dados de cliente têm `tenant_id` (decisão aprovada).
// - Compatível com Row-Level Security futura; RLS NÃO está ativa.
// - Sem database-per-tenant nem schema-per-tenant.
// - A URL de conexão vem de variável de ambiente (prisma.config.ts), nunca do código.
// - IDs: UUIDv7 gerado pelo Prisma Client (`uuid(7)`), coluna física `uuid`.
// - Datas: `timestamptz`, em UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

// Raiz do multi-tenancy: por isso NÃO possui `tenant_id`.
// login_code: código PÚBLICO (não é segredo) que resolve o tenant antes do login; único global; nulo = sem login por
// código. CHECK (fora do PSL, migration 20261012000000): ^[A-Z0-9][A-Z0-9-]{2,30}[A-Z0-9]$.
model Tenant {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  name                  String
  status                TenantStatus
  trialStartedAt        DateTime?              @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt           DateTime?              @map("trial_ends_at") @db.Timestamptz(3)
  loginCode             String?                @unique @map("login_code")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  companies             Company[]
  branches              Branch[]
  users                 User[]
  branchAccesses        UserBranchAccess[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  userRoles             UserRole[]
  devices               Device[]
  sessions              Session[]
  auditLogs             AuditLog[]
  productCategories     ProductCategory[]
  products              Product[]
  productOptionGroups   ProductOptionGroup[]
  productOptions        ProductOption[]
  branchProductSettings BranchProductSetting[]
  orders                Order[]
  orderItems            OrderItem[]
  orderItemOptions      OrderItemOption[]
  branchOrderCounters   BranchOrderCounter[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  payments              Payment[]
  refunds               Refund[]
  kitchenSectors        KitchenSector[]
  branchKitchenSectors  BranchKitchenSector[]
  kitchenTickets        KitchenTicket[]
  kitchenTicketItems    KitchenTicketItem[]
  userPreferences       UserPreference[]

  @@map("tenants")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

// CHECKs (fora do PSL, definidos na migration): cnpj = 14 dígitos; legal_name e trade_name não vazios.
model Company {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  legalName String        @map("legal_name")
  tradeName String        @map("trade_name")
  cnpj      String
  status    CompanyStatus
  timezone  String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branches  Branch[]

  @@unique([tenantId, cnpj])
  // Alvo da FK composta de Branch: garante que a Company pertence ao mesmo tenant da Branch.
  @@unique([tenantId, id])
  // Sem índice isolado em tenant_id: (tenant_id, status), (tenant_id, cnpj) e (tenant_id, id) já começam por ele (M1.14.3).
  @@index([tenantId, status])
  @@map("companies")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

// CHECKs (fora do PSL, definidos na migration): name e code não vazios; cnpj nulo ou 14 dígitos.
model Branch {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  companyId       String                 @map("company_id") @db.Uuid
  name            String
  code            String
  cnpj            String?
  status          BranchStatus
  timezone        String
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta (tenant_id, company_id) -> companies(tenant_id, id): impede Company de outro tenant.
  company         Company                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  userAccesses    UserBranchAccess[]
  devices         Device[]
  auditLogs       AuditLog[]
  productSettings BranchProductSetting[]
  orders          Order[]
  orderCounters   BranchOrderCounter[]
  cashSessions    CashSession[]
  kitchenSectors  BranchKitchenSector[]

  @@unique([tenantId, code])
  // NULLS DISTINCT (padrão do PostgreSQL): várias branches sem CNPJ são permitidas.
  @@unique([tenantId, cnpj])
  // Alvo da FK composta de UserBranchAccess.
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, status])
  @@map("branches")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED

  @@map("user_status")
}

// Funcionário individual (login: matrícula + senha). Sem coluna de senha em texto puro.
// CHECKs (fora do PSL, definidos na migration): name e password_hash não vazios; employee_number normalizado
// ^[A-Z0-9._-]{1,32}$ (migration 20261012010000);
// failed_login_attempts >= 0.
model User {
  id                  String             @id @default(uuid(7)) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  name                String
  employeeNumber      String             @map("employee_number")
  passwordHash        String             @map("password_hash")
  status              UserStatus
  mustChangePassword  Boolean            @default(false) @map("must_change_password")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?          @map("last_login_at") @db.Timestamptz(3)
  disabledAt          DateTime?          @map("disabled_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchAccesses      UserBranchAccess[]
  roles               UserRole[]
  sessions            Session[]
  ordersCreated       Order[]            @relation("OrderCreatedBy")
  ordersCancelled     Order[]            @relation("OrderCancelledBy")
  cashSessionsOpened  CashSession[]      @relation("CashSessionOpenedBy")
  cashSessionsClosed  CashSession[]      @relation("CashSessionClosedBy")
  cashMovements       CashMovement[]     @relation("CashMovementCreatedBy")
  refunds             Refund[]           @relation("RefundCreatedBy")
  auditLogs           AuditLog[]
  preferences         UserPreference?

  @@unique([tenantId, employeeNumber])
  // Alvo da FK composta de UserBranchAccess.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("users")
}

// Filiais que um usuário pode acessar (0..N, mesmo tenant). Não é papel/permissão.
// Sem updated_at: o vínculo não tem dados mutáveis; existe ou não existe.
model UserBranchAccess {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // FKs compostas: User e Branch precisam pertencer ao mesmo tenant do vínculo.
  user      User       @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch    Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Roles escopadas a esta filial dependem deste acesso.
  userRoles UserRole[]

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, branchId])
  @@map("user_branch_access")
}

enum RoleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("role_status")
}

// Papel do RBAC, por tenant. Códigos padrão previstos (templates, criados no provisionamento futuro):
// OWNER, MANAGER, ATTENDANT, KITCHEN. Roles customizadas usam is_system = false.
// Sozinha, uma Role não concede permissão alguma: permissões via RolePermission, atribuição via UserRole.
// CHECKs (fora do PSL, definidos na migration): code e name não vazios.
model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  status      RoleStatus
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  // Alvo da FK composta de RolePermission (id já é PK; não cria regra funcional nova).
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("roles")
}

// Catálogo técnico GLOBAL de permissões (sem tenant_id): controlado pelo sistema via seed.
// `code` (<module>.<action>) é identificador técnico estável usado pelo código da aplicação.
// Sem tenant, usuário, role ou escopo de filial: associações entram em módulos posteriores.
// CHECKs (fora do PSL, definidos na migration): formato de code; module e description não vazios.
model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique
  module      String
  description String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

// Permissões concedidas a uma Role do tenant. Role é por tenant (FK composta); Permission é global
// (FK simples). Sem updated_at: o vínculo existe ou não existe. Não liga Role a User.
model RolePermission {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, roleId, permissionId])
  // Consulta inversa (quais roles usam a permissão) e checagem do RESTRICT ao apagar uma permissão.
  @@index([permissionId])
  @@map("role_permissions")
}

// Role atribuída a um User. branch_id NULL = role válida em todo o tenant; preenchido = só naquela filial,
// e então exige UserBranchAccess (FK composta, verificada pelo PostgreSQL apenas quando branch_id não é NULL).
// Sem updated_at: para mudar uma atribuição, apagar e criar outra.
// Índices únicos parciais (fora do PSL, definidos na migration):
//   user_roles_tenant_scope_key  (tenant_id, user_id, role_id)            WHERE branch_id IS NULL
//   user_roles_branch_scope_key  (tenant_id, user_id, role_id, branch_id) WHERE branch_id IS NOT NULL
model UserRole {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  roleId       String            @map("role_id") @db.Uuid
  branchId     String?           @map("branch_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role         Role              @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Escopo por filial: garante Branch no mesmo tenant e acesso do usuário (dispensa FK direta para Branch).
  branchAccess UserBranchAccess? @relation(fields: [tenantId, userId, branchId], references: [tenantId, userId, branchId], onDelete: Restrict, onUpdate: Restrict)

  // Roles de um usuário (todas ou numa filial) e lookups das FKs para users e user_branch_access.
  @@index([tenantId, userId, branchId])
  // Usuários com uma role (consulta inversa) e lookup da FK para roles.
  @@index([tenantId, roleId])
  @@map("user_roles")
}

enum DeviceType {
  POS
  TABLET
  ADMIN
  KITCHEN_DISPLAY
  EDGE

  @@map("device_type")
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED

  @@map("device_status")
}

// Terminal/dispositivo conhecido pelo ERP, do tenant; branch_id NULL = dispositivo de nível do tenant.
// device_key é identificador técnico estável (NÃO é segredo). Sem pairing, autenticação, segredo ou heartbeat.
// CHECKs (fora do PSL, definidos na migration): name e device_key não vazios.
model Device {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  branchId   String?      @map("branch_id") @db.Uuid
  name       String
  deviceType DeviceType   @map("device_type")
  deviceKey  String       @map("device_key")
  status     DeviceStatus
  lastSeenAt DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando branch_id não é NULL; filial sempre do mesmo tenant.
  branch     Branch?      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions   Session[]
  auditLogs  AuditLog[]

  @@unique([tenantId, deviceKey])
  // Alvo da FK composta de Session (id já é PK; não cria regra funcional nova).
  @@unique([tenantId, id])
  @@index([tenantId, status])
  // Listagem por filial e lookup da FK para branches.
  @@index([tenantId, branchId])
  @@map("devices")
}

// Sessão persistente (base para Auth no M2): só o HASH do refresh token atual; access token nunca é persistido.
// Estado derivado: ativa = revoked_at IS NULL AND expires_at > now(); revogada = revoked_at IS NOT NULL;
// expirada = expires_at <= now(). Sem status nem updated_at: eventos de segurança usam datas próprias.
// CHECKs (fora do PSL, definidos na migration): refresh_token_hash não vazio; expires_at > created_at.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user             User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando device_id não é NULL; dispositivo sempre do mesmo tenant.
  device           Device?   @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Sessões de um usuário e lookup da FK para users.
  @@index([tenantId, userId])
  // Sessões de um dispositivo e lookup da FK para devices.
  @@index([tenantId, deviceId])
  @@map("sessions")
}

// Trilha de auditoria append-only do tenant: só INSERT no fluxo normal (sem updated_at, status ou soft delete).
// Ator e contexto opcionais: user_id NULL = evento sem usuário (worker, rotina, sistema, só dispositivo);
// branch_id/device_id NULL = sem filial/dispositivo. FKs compostas MATCH SIMPLE: verificadas só quando preenchidas.
// resource_id é referência lógica/polimórfica a qualquer recurso: SEM FK, de propósito (o log sobrevive ao recurso).
// metadata NUNCA guarda credenciais (senha, hash, tokens, segredos, chaves, PIN, cartão completo).
// CHECKs (fora do PSL, definidos na migration): formato de action e de resource_type.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.Inet
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User?    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch       Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device       Device?  @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Linha do tempo do tenant.
  @@index([tenantId, createdAt])
  // Ações de um usuário, de uma filial e de um dispositivo; também atendem as FKs compostas.
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, deviceId, createdAt])
  // Histórico de um recurso (referência lógica, sem FK).
  @@index([tenantId, resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

// ── M4: produtos e cardápio ─────────────────────────────────────────────────────────────────────────────────────────
// Cardápio ÚNICO por tenant; cada filial só desliga produto e/ou sobrescreve preço (BranchProductSetting).
// Dinheiro: numeric(12,2) em reais (nunca float). Sem exclusão de categoria/produto (status). Grupos/opções são
// substituídos em bloco (DELETE + INSERT). Campos fiscais ficam para o M9.

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE

  @@map("product_category_status")
}

// CHECKs (fora do PSL, migration 20261108000000): name não vazio; sort_order 0..9999.
model ProductCategory {
  id        String                @id @default(uuid(7)) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int                   @default(0) @map("sort_order")
  status    ProductCategoryStatus
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products  Product[]

  // Alvo da FK composta de Product.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("product_categories")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

// CHECKs (fora do PSL, migration 20261108000000): name não vazio; description nula ou não vazia; code nulo ou
// ^[A-Z0-9][A-Z0-9_-]{0,31}$ (mesmo formato de Branch.code); base_price >= 0; sort_order 0..9999.
model Product {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  categoryId      String?                @map("category_id") @db.Uuid
  // M7: setor de preparo do tenant; NULL = setor padrão.
  kitchenSectorId String?                @map("kitchen_sector_id") @db.Uuid
  name            String
  description     String?
  code            String?
  basePrice       Decimal                @map("base_price") @db.Decimal(12, 2)
  sortOrder       Int                    @default(0) @map("sort_order")
  status          ProductStatus
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando category_id não é NULL; categoria sempre do mesmo tenant.
  category        ProductCategory?       @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // M7: FK composta MATCH SIMPLE: verificada só quando kitchen_sector_id não é NULL; setor sempre do mesmo tenant.
  kitchenSector   KitchenSector?         @relation(fields: [tenantId, kitchenSectorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  optionGroups    ProductOptionGroup[]
  linkedBy        ProductOption[]        @relation("ProductOptionLinkedProduct")
  branchSettings  BranchProductSetting[]
  orderItems      OrderItem[]

  // NULLS DISTINCT (padrão do PostgreSQL): vários produtos sem código são permitidos.
  @@unique([tenantId, code])
  // Alvo das FKs compostas de ProductOptionGroup, ProductOption (vínculo de combo) e BranchProductSetting.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, kitchenSectorId])
  @@map("products")
}

// Grupo de opções de um produto (variação, adicional ou combo). Sem UPDATE em runtime: substituído em bloco.
// CHECKs (fora do PSL, migration 20261108000000): name não vazio; 0 <= min_choices <= max_choices; max_choices >= 1;
// sort_order 0..9999. "max_choices <= nº de opções" fica na aplicação (depende de outra tabela).
model ProductOptionGroup {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  name       String
  minChoices Int             @map("min_choices")
  maxChoices Int             @map("max_choices")
  sortOrder  Int             @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product    Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  options    ProductOption[]

  // Ordem única dentro do produto; também atende a FK composta (tenant_id, product_id).
  @@unique([tenantId, productId, sortOrder])
  // Alvo da FK composta de ProductOption: leva product_id junto para a opção comparar o vínculo de combo com o
  // próprio produto num CHECK (sem trigger).
  @@unique([tenantId, productId, id])
  @@map("product_option_groups")
}

// Opção de um grupo. product_id é cópia do produto do grupo, garantida pela FK composta (tenant_id, product_id,
// group_id) -> product_option_groups(tenant_id, product_id, id); serve ao CHECK de auto-vínculo e à substituição em
// bloco. linked_product_id = combo. CHECKs (fora do PSL, migration 20261108000000): name não vazio; price_delta >= 0;
// sort_order 0..9999; linked_product_id nulo ou diferente de product_id. "Combo não aninha combo" fica na aplicação
// (com trava das linhas de products), pois depende de outras linhas.
model ProductOption {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  productId       String             @map("product_id") @db.Uuid
  groupId         String             @map("group_id") @db.Uuid
  name            String
  priceDelta      Decimal            @map("price_delta") @db.Decimal(12, 2)
  linkedProductId String?            @map("linked_product_id") @db.Uuid
  sortOrder       Int                @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  group           ProductOptionGroup @relation(fields: [tenantId, productId, groupId], references: [tenantId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando linked_product_id não é NULL.
  linkedProduct   Product?           @relation("ProductOptionLinkedProduct", fields: [tenantId, linkedProductId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Ordem única dentro do grupo; também atende a FK composta do grupo e a busca/remoção por produto.
  @@unique([tenantId, productId, groupId, sortOrder])
  // "Quem vincula este produto?" (combo não aninha) e FK composta do produto vinculado.
  @@index([tenantId, linkedProductId])
  @@map("product_options")
}

// Ajuste de um produto numa filial. Ausência = disponível com o preço base; price NULL = preço base.
// CHECK (fora do PSL, migration 20261108000000): price nulo ou >= 0.
model BranchProductSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  available Boolean
  price     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Um ajuste por produto por filial; também atende a FK composta da filial.
  @@unique([tenantId, branchId, productId])
  @@index([tenantId, productId])
  @@map("branch_product_settings")
}

// ── M5: pedidos do PDV (balcão com senha) ───────────────────────────────────────────────────────────────────────────
// Vendas nunca são apagadas fisicamente. Itens e opções são CÓPIAS (snapshot) do cardápio no momento do pedido.
// Imutabilidade imposta também no banco (migration 20261109000000): itens/opções só mudam com o pedido EDITING; depois
// da confirmação, só status, timestamps de estado e dados de cancelamento mudam, e só em transições válidas; DELETE em
// orders é sempre rejeitado. Pagamento (M6) e fiscal (M9) ficam fora.

enum OrderStatus {
  EDITING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

// CHECKs (fora do PSL, migration 20261109000000): number >= 1; total >= 0; number/business_date/confirmed_at nulos
// juntos; timestamps coerentes com o status; dados de cancelamento só quando CANCELLED, motivo obrigatório se o pedido
// já tinha sido confirmado; cancel_reason não vazio e <= 200.
model Order {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  status         OrderStatus
  // Número do dia na filial; atribuído na confirmação (contador branch_order_counters).
  number         Int?
  // Dia de operação no fuso da filial (branches.timezone) em que o número foi atribuído.
  businessDate   DateTime?       @map("business_date") @db.Date
  total          Decimal         @db.Decimal(12, 2)
  createdBy      String          @map("created_by") @db.Uuid
  confirmedAt    DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  preparingAt    DateTime?       @map("preparing_at") @db.Timestamptz(3)
  readyAt        DateTime?       @map("ready_at") @db.Timestamptz(3)
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy    String?         @map("cancelled_by") @db.Uuid
  cancelReason   String?         @map("cancel_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch         Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  creator        User            @relation("OrderCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando cancelled_by não é NULL.
  canceller      User?           @relation("OrderCancelledBy", fields: [tenantId, cancelledBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  items          OrderItem[]
  payments       Payment[]
  // M7: comandas por setor, criadas na confirmação.
  kitchenTickets KitchenTicket[]

  // Alvo da FK composta de OrderItem.
  @@unique([tenantId, id])
  // M6: alvo da FK composta de Payment (leva branch_id: pagamento e caixa da mesma filial do pedido).
  @@unique([tenantId, branchId, id])
  // Número único por filial e dia (NULLs não colidem: rascunhos não têm número). Também atende filtros por dia.
  @@unique([tenantId, branchId, businessDate, number])
  // Listagem da filial (mais recentes primeiro); também atende a FK composta da filial.
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, branchId, status])
  @@index([tenantId, createdBy])
  @@index([tenantId, cancelledBy])
  @@map("orders")
}

// Item do pedido (snapshot). product_id é referência histórica com FK (produtos nunca são apagados).
// CHECKs (fora do PSL, migration 20261109000000): quantity 1..99; unit_price >= 0; line_total = unit_price * quantity;
// product_name não vazio; product_code nulo ou no formato de products.code; note nula ou não vazia e <= 140;
// sort_order 0..99.
model OrderItem {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  orderId            String              @map("order_id") @db.Uuid
  productId          String              @map("product_id") @db.Uuid
  productName        String              @map("product_name")
  productCode        String?             @map("product_code")
  quantity           Int
  unitPrice          Decimal             @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal             @map("line_total") @db.Decimal(12, 2)
  note               String?
  sortOrder          Int                 @map("sort_order")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order              Order               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product            Product             @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  options            OrderItemOption[]
  kitchenTicketItems KitchenTicketItem[]

  // Ordem única no pedido; também atende a FK composta do pedido.
  @@unique([tenantId, orderId, sortOrder])
  // Alvo da FK composta de OrderItemOption.
  @@unique([tenantId, id])
  // M7: alvo da FK composta de KitchenTicketItem (leva order_id: item da comanda e da venda do MESMO pedido).
  @@unique([tenantId, orderId, id])
  @@index([tenantId, productId])
  @@map("order_items")
}

// Opção escolhida num item (snapshot). option_id e linked_product_id são referências HISTÓRICAS sem FK: opções são
// apagadas na substituição de grupos do M4, e o vínculo de combo é só cópia do cardápio.
// CHECKs (fora do PSL, migration 20261109000000): group_name e name não vazios; price_delta >= 0; sort_order 0..999.
model OrderItemOption {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderItemId     String    @map("order_item_id") @db.Uuid
  optionId        String    @map("option_id") @db.Uuid
  groupName       String    @map("group_name")
  name            String
  priceDelta      Decimal   @map("price_delta") @db.Decimal(12, 2)
  linkedProductId String?   @map("linked_product_id") @db.Uuid
  sortOrder       Int       @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItem       OrderItem @relation(fields: [tenantId, orderItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Ordem única no item; também atende a FK composta do item.
  @@unique([tenantId, orderItemId, sortOrder])
  // Cada opção no máximo uma vez por item.
  @@unique([tenantId, orderItemId, optionId])
  @@map("order_item_options")
}

// Contador do número do pedido por filial e dia de operação. Incrementado atomicamente na confirmação
// (INSERT ... ON CONFLICT DO UPDATE ... RETURNING). CHECK (migration 20261109000000): last_number >= 1.
model BranchOrderCounter {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  lastNumber   Int      @map("last_number")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch       Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Um contador por filial e dia; também atende a FK composta da filial.
  @@unique([tenantId, branchId, businessDate])
  @@map("branch_order_counters")
}

// ── M6: caixa e pagamentos ──────────────────────────────────────────────────────────────────────────────────────────
// Registros financeiros nunca são alterados nem apagados: payments, refunds e cash_movements são append-only (triggers);
// cash_sessions só passa de OPEN para CLOSED uma vez. Pagamento, estorno e movimento carregam branch_id e apontam para o
// caixa por FK composta (tenant_id, branch_id, cash_session_id): o banco garante que caem num caixa DA MESMA FILIAL do
// pedido. PIX/cartão são registro manual (sem PSP/TEF). Fiscal fica no M9.

enum CashSessionStatus {
  OPEN
  CLOSED

  @@map("cash_session_status")
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL

  @@map("cash_movement_type")
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD

  @@map("payment_method")
}

// Caixa de um operador numa filial. Índice único PARCIAL (fora do PSL, migration 20261110000000): no máximo um OPEN por
// (tenant_id, branch_id, opened_by). CHECKs: valores >= 0; CLOSED <=> campos de fechamento preenchidos;
// difference = counted_cash - expected_cash; justificativa obrigatória quando difference <> 0 (3..500).
model CashSession {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  status        CashSessionStatus
  openedBy      String            @map("opened_by") @db.Uuid
  openedAt      DateTime          @map("opened_at") @db.Timestamptz(3)
  openingAmount Decimal           @map("opening_amount") @db.Decimal(12, 2)
  closedBy      String?           @map("closed_by") @db.Uuid
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz(3)
  expectedCash  Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  countedCash   Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  // Contado − esperado; pode ser negativo (falta).
  difference    Decimal?          @db.Decimal(12, 2)
  justification String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch        Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  opener        User              @relation("CashSessionOpenedBy", fields: [tenantId, openedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando closed_by não é NULL.
  closer        User?             @relation("CashSessionClosedBy", fields: [tenantId, closedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  movements     CashMovement[]
  payments      Payment[]
  refunds       Refund[]

  // Alvo das FKs compostas de pagamento, estorno e movimento: leva branch_id para garantir a mesma filial.
  @@unique([tenantId, branchId, id])
  // Listagem da filial (mais recentes primeiro); também atende a FK composta da filial.
  @@index([tenantId, branchId, openedAt(sort: Desc)])
  @@index([tenantId, openedBy])
  @@index([tenantId, closedBy])
  @@map("cash_sessions")
}

// Sangria (WITHDRAWAL) ou suprimento (SUPPLY). Append-only. CHECKs: amount > 0; reason não vazio e <= 200.
model CashMovement {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  branchId      String           @map("branch_id") @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cashSession   CashSession      @relation(fields: [tenantId, branchId, cashSessionId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  creator       User             @relation("CashMovementCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, branchId, cashSessionId])
  @@index([tenantId, createdBy])
  @@map("cash_movements")
}

// Pagamento registrado na confirmação do pedido. Append-only. FKs compostas com branch_id: pedido e caixa da MESMA
// filial. CHECKs: amount > 0; CASH <=> received_amount >= amount e change = received_amount - amount; demais métodos sem
// received_amount e change = 0; reference nula ou não vazia e <= 60.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  cashSessionId  String        @map("cash_session_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  receivedAmount Decimal?      @map("received_amount") @db.Decimal(12, 2)
  change         Decimal       @db.Decimal(12, 2)
  reference      String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order          Order         @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  cashSession    CashSession   @relation(fields: [tenantId, branchId, cashSessionId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  refund         Refund?

  // Alvo da FK composta do estorno: obriga o estorno a repetir pedido, método e valor do pagamento (estorno total).
  @@unique([tenantId, branchId, id, orderId, method, amount])
  // Busca por pedido (sempre com a filial da rota); também atende a FK composta do pedido.
  @@index([tenantId, branchId, orderId])
  @@index([tenantId, branchId, cashSessionId])
  @@map("payments")
}

// Estorno total de um pagamento (cancelamento de pedido pago). Append-only; um por pagamento. A FK composta para
// payments(tenant_id, branch_id, id, order_id, method, amount) garante no banco que o estorno tem o mesmo pedido, método e
// VALOR do pagamento. CHECKs: amount > 0; CASH <=> cash_session_id não nulo (dinheiro sai do caixa de quem cancela).
model Refund {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  paymentId     String        @map("payment_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  cashSessionId String?       @map("cash_session_id") @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment       Payment       @relation(fields: [tenantId, branchId, paymentId, orderId, method, amount], references: [tenantId, branchId, id, orderId, method, amount], onDelete: Restrict, onUpdate: Restrict)
  // FK composta MATCH SIMPLE: verificada só quando cash_session_id não é NULL (estorno em dinheiro).
  cashSession   CashSession?  @relation(fields: [tenantId, branchId, cashSessionId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  creator       User          @relation("RefundCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Um estorno por pagamento: como a FK fixa pedido, método e valor iguais aos do pagamento, esta unique equivale a
  // UNIQUE (tenant_id, payment_id); também cobre a FK composta.
  @@unique([tenantId, branchId, paymentId, orderId, method, amount])
  @@index([tenantId, branchId, cashSessionId])
  @@index([tenantId, createdBy])
  @@map("refunds")
}

// ── M7: cozinha (setores, comandas por setor) ──────────────────────────────────────────────────────────────────────
// Setores são do TENANT; a filial só liga/desliga (BranchKitchenSector; sem linha = ligado). Exatamente um setor padrão
// por tenant (índice único PARCIAL, fora do PSL). Comandas nascem na confirmação do pedido (uma por setor efetivo) e nunca
// são apagadas; os itens da comanda nunca mudam (triggers da migration 20261110020000). Sem preços: a cozinha não vê valores.

enum KitchenSectorStatus {
  ACTIVE
  INACTIVE

  @@map("kitchen_sector_status")
}

// Índice único PARCIAL (fora do PSL, migration 20261110020000): um is_default por tenant. CHECKs: name não vazio e <= 60;
// code no formato de products.code; sort_order 0..9999; o padrão é sempre ACTIVE.
model KitchenSector {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  name           String
  code           String
  isDefault      Boolean               @map("is_default")
  status         KitchenSectorStatus
  sortOrder      Int                   @default(0) @map("sort_order")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       Product[]
  branchSettings BranchKitchenSector[]
  tickets        KitchenTicket[]

  // Código único no tenant.
  @@unique([tenantId, code])
  // Alvo das FKs compostas de Product, BranchKitchenSector e KitchenTicket.
  @@unique([tenantId, id])
  @@map("kitchen_sectors")
}

// Setor ligado/desligado numa filial. Ausência = ligado. O padrão nunca é desligado (regra da aplicação, com a linha do
// setor travada).
model BranchKitchenSector {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  branchId  String        @map("branch_id") @db.Uuid
  sectorId  String        @map("sector_id") @db.Uuid
  enabled   Boolean
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch    Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sector    KitchenSector @relation(fields: [tenantId, sectorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Um ajuste por setor por filial; também atende a FK composta da filial.
  @@unique([tenantId, branchId, sectorId])
  @@index([tenantId, sectorId])
  @@map("branch_kitchen_sectors")
}

enum KitchenTicketStatus {
  WAITING
  PREPARING
  READY
  CANCELLED

  @@map("kitchen_ticket_status")
}

// Comanda de um setor num pedido. Nome e código do setor são CÓPIAS do momento da confirmação. FK composta com branch_id:
// comanda da MESMA filial do pedido. CHECKs: timestamps coerentes com o status; print_count >= 0 e last_printed_at
// preenchido <=> print_count > 0; sector_name não vazio; sector_code no formato do código do setor.
// Trigger kitchen_tickets_guard: nasce WAITING com o pedido CONFIRMED; nunca é apagada; só transições válidas;
// identidade, cópias e timestamps já gravados nunca mudam; impressão só incrementa a contagem.
model KitchenTicket {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  branchId      String              @map("branch_id") @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  sectorId      String              @map("sector_id") @db.Uuid
  sectorName    String              @map("sector_name")
  sectorCode    String              @map("sector_code")
  status        KitchenTicketStatus
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(3)
  readyAt       DateTime?           @map("ready_at") @db.Timestamptz(3)
  cancelledAt   DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  printCount    Int                 @default(0) @map("print_count")
  lastPrintedAt DateTime?           @map("last_printed_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order         Order               @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  sector        KitchenSector       @relation(fields: [tenantId, sectorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  items         KitchenTicketItem[]

  // Uma comanda por setor por pedido.
  @@unique([tenantId, orderId, sectorId])
  // Alvo da FK composta de KitchenTicketItem (leva order_id: item da comanda do mesmo pedido).
  @@unique([tenantId, orderId, id])
  // FK composta do pedido; comandas de um pedido.
  @@index([tenantId, branchId, orderId])
  // Fila da filial em ordem de chegada.
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, sectorId])
  @@map("kitchen_tickets")
}

// Item da comanda: só o vínculo com o item do pedido (os dados saem do snapshot da venda). Append-only (trigger
// kitchen_ticket_items_guard): só entra com a comanda WAITING e nunca impressa; nunca muda nem é apagado. As duas FKs
// compostas carregam order_id: comanda e item da venda do MESMO pedido e tenant.
model KitchenTicketItem {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  orderItemId String        @map("order_item_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket      KitchenTicket @relation(fields: [tenantId, orderId, ticketId], references: [tenantId, orderId, id], onDelete: Restrict, onUpdate: Restrict)
  orderItem   OrderItem     @relation(fields: [tenantId, orderId, orderItemId], references: [tenantId, orderId, id], onDelete: Restrict, onUpdate: Restrict)

  // Cada item do pedido em exatamente uma comanda; também atende a FK composta do item.
  @@unique([tenantId, orderId, orderItemId])
  @@index([tenantId, orderId, ticketId])
  @@map("kitchen_ticket_items")
}

// ── KAN-42: preferências do próprio usuário ─────────────────────────────────────────────────────────────────────────
// Uma linha por usuário (único (tenant_id, user_id), que também é o alvo do upsert). Sem linha = defaults do contrato
// (`catalogView` GRID). Só o próprio usuário lê/grava (tenant e usuário do AuthContext, nunca do corpo).
// CHECK (fora do PSL, na migration): catalog_view IN ('GRID', 'LIST'). tenant_id imutável (trigger). Sem DELETE.
model UserPreference {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  catalogView String   @map("catalog_view")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user        User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Um registro por usuário; também atende a FK composta para users.
  @@unique([tenantId, userId])
  @@map("user_preferences")
}
