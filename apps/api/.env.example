# Exemplo de variáveis da API. SOMENTE nomes e placeholders: nunca commitar valores reais (.env* está no .gitignore).
# Em produção os valores vêm do cofre de segredos (Secrets Manager, TBD), nunca de arquivo.

# Runtime: conexão como erp_app (nunca erp_migrator nem a identidade admin). Ver infrastructure/postgres/README.md.
DATABASE_URL=postgresql://erp_app:<senha>@<host>:5432/<database>

# Chave HMAC (HS256) do access token. Obrigatória em TODO ambiente; >= 32 bytes, aleatória
# (ex.: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
# Placeholder/fraca/ausente = a API não sobe. Trocar a chave invalida todos os access tokens emitidos.
AUTH_ACCESS_TOKEN_SECRET=

# Opcionais (segundos). Decididos no M2: 900 (access, 15 min) e 43200 (sessão absoluta, 12 h, sem sliding).
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=43200

# Origens exatas do frontend (https em produção), separadas por vírgula: Origin aceito em /auth/login|refresh|logout.
# Obrigatória em produção.
AUTH_ALLOWED_ORIGINS=

# Cookie do refresh com Secure (+ prefixo __Secure-). Padrão true; "false" só fora de produção (ex.: http://localhost).
# AUTH_COOKIE_SECURE=true

# Testes de integração: servidor PostgreSQL 17.x UTF8 DEDICADO a testes (o setup cria e remove bancos/roles próprios).
# TEST_DATABASE_URL=postgresql://postgres:<senha>@127.0.0.1:5432/postgres
